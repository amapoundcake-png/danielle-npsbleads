# Brevo (SMTP relay + API) — https://app.brevo.com/settings/keys/smtp
BREVO_LOGIN=hello@danniadams.me
BREVO_SMTP_KEY=your_brevo_smtp_key_here
# Optional — falls back to BREVO_SMTP_KEY if unset
BREVO_API_KEY=

# Notion — integration token from https://www.notion.so/my-integrations,
# shared with the outreach log database, plus that database's ID
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Sender inboxes (defaults already match config.py — only needed if they change)
SENDER_EMAIL_HELLO=hello@danniadams.me
SENDER_EMAIL_SPEAKING=speaking@danniadams.me
SENDER_EMAIL_PARTNERSHIPS=partnerships@danniadams.me

# Follow-up / check-in timing
FOLLOW_UP_DAYS_MIN=4
FOLLOW_UP_DAYS_MAX=6

# Daily lead volume target
DAILY_LEAD_TARGET=36

# Optional: Google Maps lead sourcing (leave blank to skip that source)
GOOGLE_MAPS_API_KEY=
